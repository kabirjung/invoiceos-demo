{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app.js", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "status": 200, "dest": "/app.js" },
    { "src": "/favicon.ico", "status": 204 },
    { "src": "/(.*)", "status": 200, "dest": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}

{
  "version": 2,
  "builds": [
    { "src": "server.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/favicon.ico", "status": 204 },
    { "src": "/api/(.*)", "dest": "/server.py" },
    { "src": "/demo(/?)", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
